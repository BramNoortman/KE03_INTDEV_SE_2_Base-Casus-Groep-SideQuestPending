@model DataAccessLayer.Models.Klacht

@{
    ViewData["Title"] = "Klacht bewerken";
}

<div class="driver-form">
    <h1>Klacht bewerken</h1>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Onderwerp" />
                <input type="hidden" asp-for="Beschrijving" />
                <input type="hidden" asp-for="AangemaaktOp" />

                @* Klant info *@
                <div class="mb-3">
                    <label class="form-label">Klant</label>
                    <input class="form-control"
                           value="@Model.Customer?.Name (ID: @Model.Customer?.Id)"
                           readonly />
                </div>

                @* Read-only weergave *@
                <div class="mb-3">
                    <label class="form-label">Onderwerp</label>
                    <input class="form-control" value="@Model.Onderwerp" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Beschrijving</label>
                    <textarea class="form-control" rows="4" readonly>@Model.Beschrijving</textarea>
                </div>

                @* STATUS DROPDOWN *@
                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status</label>

                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="In behandeling">In behandeling</option>
                        <option value="Afgehandeld">Afgehandeld</option>
                    </select>

                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AangemaaktOp" class="form-label">Aangemaakt op</label>
                    <input asp-for="AangemaaktOp" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Opslaan</button>
                    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}