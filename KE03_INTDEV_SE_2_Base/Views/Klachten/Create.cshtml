@model DataAccessLayer.Models.Klacht

@{
    ViewData["Title"] = "Klacht aanmaken";

    var customers = ViewBag.Customers as List<DataAccessLayer.Models.Customer>;
}

<div class="driver-form">
    <h1>Nieuwe klacht aanmaken</h1>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* KLANT DROPDOWN *@
                <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label">Klant</label>

                    <select asp-for="CustomerId" class="form-select">
                        <option value="">-- Selecteer klant --</option>

                        @foreach (var customer in customers)
                        {
                            <option value="@customer.Id">
                                @customer.Name (ID: @customer.Id)
                            </option>
                        }
                    </select>

                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Onderwerp" class="form-label">Onderwerp</label>
                    <input asp-for="Onderwerp" class="form-control" />
                    <span asp-validation-for="Onderwerp" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Beschrijving" class="form-label">Beschrijving</label>
                    <textarea asp-for="Beschrijving" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Beschrijving" class="text-danger"></span>
                </div>

                @* STATUS DROPDOWN *@
                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status</label>

                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="In behandeling">In behandeling</option>
                        <option value="Afgehandeld">Afgehandeld</option>
                    </select>

                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Aanmaken</button>
                    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}