@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Order overview";
}

<div class="orders-page">
    <h1 class="mb-4">
        Orders
    </h1>

    <form method="get" class="orders-toolbar">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control search-bar" placeholder="zoek order"/>
        <button type="submit" class="btn btn-primary">
            Order aanmaken
        </button>
    </form>

    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Order Datum</th>
                        <th>Klant ID</th>
                        <th>Klant naam</th>
                        <th>Producten</th>
                        <th class="text-end">
                            Acties
                        </th>
                    </tr>
                </thead>

                @* <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
