@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Order overview";
}

<div class="orders-page">
    <h1 class="mb-4">
        Orders
    </h1>

    <form method="get" class="products-toolbar">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control search-bar" placeholder="zoek order"/>
        <a asp-action="Create" class="btn btn-primary me-2">Nieuwe Order</a>
    </form>

    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Order Datum</th>
                        <th>Klant ID</th>
                        <th>Klant naam</th>
                        <th class="text-end">
                            Acties
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.OrderDate</td>
                            <td>@order.CustomerId</td>
                            <td>@order.Customer.Name</td>

                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary me-2">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-warning me-2">
                                    Bewerken
                                </a>
                                <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-danger">
                                    Verwijderen
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>