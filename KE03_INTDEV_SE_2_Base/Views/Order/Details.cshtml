@model DataAccessLayer.Models.Order

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Order</h4>
    <hr />
    <div class="row">
        <dl class="col-md-6">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Id)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Id)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.OrderDate)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.OrderDate)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.CustomerId)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.CustomerId)
            </dd>
            <dt class = "col-sm-2">
                Customer Name
            </dt>
            <dd class = "col-sm-10">
                @if (Model.Customer != null)
                {
                    @Html.DisplayFor(model => model.Customer.Name)
                }
                else
                {
                    <span class="text-muted">(no customer)</span>
                }
            </dd>
            <dt class = "col-sm-2">
                Status
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Status)
            </dd>

            <div class="form-group">
                @{
                    var productList = ViewData["ProductListItems"] as IEnumerable<DataAccessLayer.Models.Product> ?? Enumerable.Empty<DataAccessLayer.Models.Product>();
                }
                <div>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        decimal total = 0m;
                        <table class="table">
                            <thead>
                                <tr>
                                    <th class="text-start">Product</th>
                                    <th class="text-start">Quantity</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Packed </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var name = item.Product?.Name ?? "[unknown]";
                                    var unitPrice = item.Product?.Price ?? 0m;
                                    var lineTotal = unitPrice * item.Quantity;
                                    total += lineTotal;
                                    <tr>
                                        <td>
                                            @{
                                                var existingItem = Model?.Items?.FirstOrDefault(it => it.ProductId == item.ProductId);
                                                var qty = existingItem?.Quantity ?? 0;
                                            }
                                            @qty
                                        </td>
                                        <td>@name</td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td class="text-end">@item.Packed</td>
                                    </tr>
                                }
                                <tr>
                                    <td>Shipping</td>
                                    <td>1</td>
                                    <td class="text-end">€2.00</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Total</th>
                                    <th class="text-end">€@(total + 2m)</th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No items in this order.</p>
                    }
                </div>
            </div>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning me-2">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
