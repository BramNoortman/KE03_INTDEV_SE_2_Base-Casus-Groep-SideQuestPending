<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - KE03_INTDEV_SE_2_Base</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/KE03_INTDEV_SE_2_Base.styles.css" asp-append-version="true"/>
</head>
<body>
<div class="admin-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <h3>Matrix Inc. Backoffice</h3>
        </div>

        <!-- when on a views pages we check to highlight said view for visibility and mapping-->
        <nav class="sidebar-nav">
            <a asp-controller="Home" asp-action="Index" data-controller="Home">
                Dashboard
            </a>
            <a asp-controller="Order" asp-action="Index" data-controller="Order">
                Orders
            </a>
            <a asp-controller="Products" asp-action="Index" data-controller="Products">
                Producten
            </a>
            <a asp-controller="Warehouse" asp-action="Index" data-controller="Warehouse">
                Depot
            </a>
            <a asp-controller="Drivers" asp-action="Index" data-controller="Drivers">
                Bezorgers
            </a>
            <a asp-controller="Customers" asp-action="Index" data-controller="Customers">
                Klanten
            </a>
            <a asp-controller="Klachten" asp-action="Index" data-controller="Klachten">
                Klachten
            </a>
            <a asp-controller="Finance" asp-action="Index" data-controller="Finance">
                Financiën
            </a>
            <a asp-controller="WorkInProgress" asp-action="Index" data-controller="WorkInProgress">
                Instellingen
            </a>
            <a asp-controller="WorkInProgress" asp-action="Index" data-controller="WorkInProgress">
                Uitloggen
            </a>
        </nav>
    </aside>

    <main class="main-content">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>