@using DataAccessLayer.Models
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Warehouse";
}

<h1>Depot Overzicht</h1>
<hr />

@{
    // Define all warehouse racks (A-D)
    var racks = new[] { 'A', 'B', 'C', 'D' };
}

<div class="container-fluid">
    @foreach (var rack in racks)
    {
        // Filter orders for current rack
        var ordersInRack = Model.Where(o => o.Rack == rack).ToList();
        <div class="card mb-4">
            <!-- Collapsible header with package count -->
            <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#rack-@rack">
                <h5 class="mb-0">
                    Rek @rack
                    <span class="badge bg-secondary">@ordersInRack.Count pakket(ten)</span>
                </h5>
            </div>
            <div id="rack-@rack" class="collapse show">
                <div class="card-body">
                    @if (ordersInRack.Count == 0)
                    {
                        <p class="text-muted">Geen pakketten in dit rek</p>
                    }
                    else
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Pakket ID</th>
                                    <th>Volledig Ingepakt</th>
                                    <th>Klantnaam</th>
                                    <th>Afleveradres</th>
                                    <th>Bus</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in ordersInRack)
                                {
                                    <tr>
                                        <td>@order.Id</td>
                                        <td>@order.OrderPackaged</td>
                                        <td>@order.Customer?.Name</td>
                                        <td>@order.Customer?.Address</td>
                                        <td>@(order.Driver?.BusNumber ?? "Niet toegewezen")</td>
                                        <td>
                                            @{
                                                var statusText = order.Status switch
                                                {
                                                    OrderStatus.NogNietVerzonden => "Nog niet verzonden",
                                                    OrderStatus.InDeBus => "Onderweg",
                                                    OrderStatus.Onderweg => "Bezorgd",
                                                    _ => "Onbekend"
                                                };
                                            }
                                            @statusText
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
