<div class="customers-page">
    <h1 class="mb-4">
        Klanten
    </h1>

    <form method="get" class="products-toolbar">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control search-bar" placeholder="zoek klant" />
        @* <p> *@
        @*     <a asp-action="Create">Create New</a> *@
        @* </p> *@
        <button type="submit" class="btn btn-primary" asp-action="Create">
            Create New
        </button>
    </form>

    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Klanten naam</th>
                        <th>Adress</th>
                        <th>Active</th>
                        <th class="text-end">
                            Acties
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td>@customer.Name</td>
                            <td>@customer.Active</td>

                            <td class="text-end">
                                <button class="btn btn-warning btn-sm me-2">
                                    <span asp-action="Details" asp-route-id="@customer.Id">Details</span>
                                </button>
                                <button class="btn btn-warning btn-sm me-2">
                                    <span asp-action="Edit" asp-route-id="@customer.Id">Bewerken</span>
                                </button>
                                <button class="btn btn-danger btn-sm">
                                    <span asp-action="Delete" asp-route-id="@customer.Id">Verwijderen</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>