@model IEnumerable<DataAccessLayer.Models.Customer>

@{
    ViewData["Title"] = "Klanten overview";
}
<div class="customers-page">
    <h1 class="mb-4">
        Klanten
    </h1>

@*Display searchbar *@
    <div class="d-flex justify-content-between align-items-center products-toolbar">
        <form method="get" class="products-toolbar">
            <div class="position-relative">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control search-bar" placeholder="zoek naar klant" />
                <a asp-action="Index" class="btn btn-sm btn-light position-absolute top-50 end-0 translate-middle-y me-1">✕</a> @*clear searchbar*@
            </div>
            <button type="submit" class="btn btn-secondary">Klant zoeken</button>
        </form>

        @* make customer*@
        <a asp-action="Create" class="btn btn-primary">Product aanmaken</a>
    </div>

    @*Display list of customer by id, name, adress, active status*@
    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index" asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.IdSort" class="text-white text-decoration-none">
                                Klant ID
                                @if (string.IsNullOrEmpty(ViewBag.CurrentSort))
                                {
                                    <span>▼</span>
                                }
                                else if (ViewBag.CurrentSort == "id_desc")
                                {          
                                    <span>▲</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.NameSort" class="text-white text-decoration-none">
                                Naam
                                @if (ViewBag.CurrentSort == "name")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewBag.CurrentSort == "name_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.AddressSort" class="text-white text-decoration-none">
                                Adress
                                @if (ViewBag.CurrentSort == "address")
                                {
                                    <span>▼</span>
                                }
                                else if (ViewBag.CurrentSort == "address_desc")
                                {
                                    <span>▲</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.ActiveSort" class="text-white text-decoration-none">
                                Actief
                                @if (ViewBag.CurrentSort == "active")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewBag.CurrentSort == "active_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th class="text-end">
                            Acties
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td>@customer.Name</td>
                            <td>@customer.Address</td>
                            <td>@customer.Active</td>

                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-primary">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning">
                                    Bewerken
                                </a>
                                <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-danger">
                                    Verwijderen
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>