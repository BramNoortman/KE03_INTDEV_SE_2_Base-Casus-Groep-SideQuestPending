@model IEnumerable<DataAccessLayer.Models.Customer>

@{
    ViewData["Title"] = "Klanten overview";
}
<div class="customers-page">
    <h1 class="mb-4">
        Klanten
    </h1>

    <div class="d-flex justify-content-between align-items-center products-toolbar">
        <form method="get" class="products-toolbar">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control search-bar" placeholder="zoek naar klant" />
            <button type="submit" class="btn btn-secondary">Zoeken</button>
        </form>

        <a asp-action="Create" class="btn btn-primary">Klant toevoegen</a>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Klant ID</th>
                        <th>Klanten naam</th>
                        <th>Adress</th>
                        <th>Active</th>
                        <th class="text-end">
                            Acties
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td>@customer.Name</td>
                            <td>@customer.Address</td>
                            <td>@customer.Active</td>

                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-primary">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning">
                                    Bewerken
                                </a>
                                <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-danger">
                                    Verwijderen
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>