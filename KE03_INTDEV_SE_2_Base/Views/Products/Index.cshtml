@model IEnumerable<DataAccessLayer.Models.Product>

@{
    ViewData["Title"] = "Producten overview";

    var sortField = ViewBag.SortField as string;
    var direction = ViewBag.Direction as string;
}

<div class="products-page">
    <h1 class="mb-4">
        Producten
    </h1>

    @*Display searchbar *@
    <form method="get">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <div class="position-relative">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control search-bar"
                           placeholder="Zoek product" />

                    <a asp-action="Index"
                       class="btn btn-sm btn-light position-absolute top-50 end-0 translate-middle-y me-1">
                        ✕
                    </a>
                </div>

                <label class="mb-0">Sorteer op:</label>
                <select name="sortField" class="form-select w-auto">
                    <option value="id" selected="@(sortField == "id")">ID</option>
                    <option value="name" selected="@(sortField == "name")">Productnaam</option>
                    <option value="price" selected="@(sortField == "price")">Productprijs</option>
                    <option value="description" selected="@(sortField == "description")">Omschrijving</option>
                </select>
                <select name="direction" class="form-select w-auto">
                    <option value="asc" selected="@(direction == "asc")">Oplopend</option>
                    <option value="desc" selected="@(direction == "desc")">Aflopend</option>
                </select>
                <button type="submit" class="btn btn-secondary">
                    Zoek en filter
                </button>
            </div>

            @*Make product*@
            <a asp-action="Create" class="btn btn-primary">
                Product aanmaken
            </a>
        </div>
    </form>

    @* Show list of products by id, name, price, etc*@
    <div class="card shadow-sm mt-4">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.IdSort"
                               class="d-inline-flex align-items-center gap-1 text-white text-decoration-none text-nowrap">
                                <span>ID</span>

                                @if (string.IsNullOrEmpty(ViewBag.CurrentSort))
                                {
                                    <span>▼</span>
                                }
                                else if (ViewBag.CurrentSort == "id_desc")
                                {
                                    <span>▲</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.NameSort"
                               class="d-inline-flex align-items-center gap-1 text-white text-decoration-none text-nowrap">
                                <span>Productnaam</span>

                                @if (ViewBag.CurrentSort == "name")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewBag.CurrentSort == "name_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.PriceSort"
                               class="d-inline-flex align-items-center gap-1 text-white text-decoration-none text-nowrap">
                                <span>Productprijs</span>

                                @if (ViewBag.CurrentSort == "price")
                                {
                                    <span>▼</span>
                                }
                                else if (ViewBag.CurrentSort == "price_desc")
                                {
                                    <span>▲</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-sortOrder="@ViewBag.DescriptionSort"
                               class="d-inline-flex align-items-center gap-1 text-white text-decoration-none text-nowrap">
                                <span>Omschrijving</span>

                                @if (ViewBag.CurrentSort == "description")
                                {
                                    <span>▲</span>
                                }
                                else if (ViewBag.CurrentSort == "description_desc")
                                {
                                    <span>▼</span>
                                }
                            </a>
                        </th>
                        <th style="min-width: 400px" class="text-end">
                            Acties
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Name</td>
                            <td>€@product.Price.ToString("F2")</td>
                            <td>@product.Description</td>

                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-primary">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning">
                                    Bewerken
                                </a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger">
                                    Verwijderen
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>